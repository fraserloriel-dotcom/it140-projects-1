# Project One Get-Item Pseudocode
#
def get_item_logic(current_room, rooms_dict, inventory):
    # 1. SET room_item TO item in rooms_dict[current_room]
    # Using .get('item') prevents a crash if the room doesn't have an item
    room_item = rooms_dict[current_room].get('item')
    
    # 3. OUTPUT "Enter command: "
    # 4. INPUT user_input
    user_input = input("Enter command: ").strip()
    
    # 5. SET requested_item TO target item from user_input
    # Assuming the player types something like "get potion"
    words = user_input.split()
    if len(words) >= 2:
        requested_item = words[1].capitalize()
    else:
        requested_item = ""
        
    # 7. IF requested_item == room_item THEN
    if requested_item == room_item:
        # 8. ADD requested_item TO inventory
        inventory.append(requested_item)
        
        # 9. REMOVE item from rooms_dict[current_room]
        del rooms_dict[current_room]['item']
        
        # 10. OUTPUT "You picked up the " + requested_item
        print("You picked up the " + requested_item)
        
    # 11. ELSE
    else:
        # 12. OUTPUT "There is no " + requested_item + " in this room."
        if requested_item:
            print("There is no " + requested_item + " in this room.")
        else:
            print("You didn't specify an item to get!")
            
    # 15. RETURN inventory
    return inventory

