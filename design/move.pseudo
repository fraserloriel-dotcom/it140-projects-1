def move_player(command, current_room, rooms):
    # 1. SET words TO split command by spaces
    words = command.split()
    
    # 3. IF length of words >= 2 AND words[0] == "go" THEN
    if len(words) >= 2 and words[0].lower() == "go":
        # 4. SET direction TO capitalize words[1]
        direction = words[1].capitalize() 
        
    # 5. ELSE IF length of words == 1 THEN
    elif len(words) == 1:
        # 6. SET direction TO capitalize words[0]
        direction = words[0].capitalize()
        
    # 7. ELSE
    else:
        # 8. OUTPUT "Invalid command format."
        print("Invalid command format.")
        # 9. RETURN current_room
        return current_room
        
    # 12. IF direction IN rooms[current_room] THEN
    if direction in rooms[current_room]:
        # 13. SET current_room TO rooms[current_room][direction]
        current_room = rooms[current_room][direction]
        # 14. OUTPUT "You moved to the " + current_room
        print("You moved to the " + current_room)
        
    # 15. ELSE
    else:
        # 16. OUTPUT "You can't go that way!"
        print("You can't go that way!")
        
    # 19. RETURN current_room
    return current_room
